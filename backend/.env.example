# Copie este arquivo para ".env" e ajuste os valores.

# Porta da API
PORT=3001

# Segredo para assinar os tokens JWT (use um valor longo e aleatório em produção)
JWT_SECRET=troque_por_um_segredo_aleatorio

# String de conexão do PostgreSQL (ex.: Neon, Supabase, Render Postgres)
# postgresql://usuario:senha@host/dbname?sslmode=require
DATABASE_URL=

# Defina PGSSL=disable apenas para um Postgres LOCAL sem SSL.
# PGSSL=disable
